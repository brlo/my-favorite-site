<% @page_title = 'Сводка' %>

<div class="admin-dashboard">
  <h1>Сводка</h1>

  <% owner_pages = current_user.pages_owner.to_a.any? ? ::Page.where(id: current_user.pages_owner.to_a).order(:title).to_a : [] %>
  <% if owner_pages.any? %>
    <section class="author-admin-callout">
      <div class="author-admin-callout__title">Управляйте статьями и меню прямо на странице</div>
      <p>На вашей странице над меню есть кнопки «＋ Новая статья» и
        «✎ Редактировать меню на странице».</p>
      <div class="author-admin-callout__links">
        <% owner_pages.each do |owner_page| %>
          <%= link_to owner_page.title, admin_public_page_path(owner_page), class: 'btn btn-small',
                target: '_blank', rel: 'noopener' %>
        <% end %>
      </div>
    </section>
  <% end %>

  <% if @reading_now %>
    <section id="reading-now" class="dash-card">
      <h2 class="dash-card__title">
        <span class="dash-card__dot" aria-hidden="true"></span>
        Читают сейчас
        <span class="dash-card__total">Всего на сайте: <%= @reading_now_total %></span>
      </h2>
      <p class="dash-card__lead">
        Страницы на всех языках и книги Библии, которые читают прямо сейчас (по JS-маячку).
        Отметка живёт до <%= ::PageVisits::READING_WINDOW / 60 %> минут после последнего сигнала.
      </p>

      <% if @reading_now.any? || @reading_now_bibles.any? %>
        <ul class="dash-list">
          <% @reading_now.each do |page, count| %>
            <li class="dash-list__row">
              <span class="dash-list__main">
                <%= link_to page.title, edit_admin_page_path(page, locale: nil) %>
                <span class="dash-badge" title="<%= page_lang_string_full(page.lang) %>"><%= page.lang %></span>
              </span>
              <span class="dash-count" title="Читателей: <%= count %>"><%= count %></span>
            </li>
          <% end %>
          <% @reading_now_bibles.each do |content_lang, book_code, count| %>
            <li class="dash-list__row">
              <span class="dash-list__main">
                <span class="dash-list__title">Библия · <%= ::I18n.t("books.full.#{book_code}") %></span>
                <span class="dash-badge"><%= ::BIB_LANG_TO_LOCALE[content_lang] || content_lang %></span>
                <span class="dash-list__note"><%= ::I18n.t("bib_translations.#{content_lang}", default: content_lang) %></span>
              </span>
              <span class="dash-count" title="Читателей: <%= count %>"><%= count %></span>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="dash-card__empty">Сейчас никто не читает.</p>
      <% end %>
    </section>
  <% end %>

  <% if @reactions_total %>
    <section id="reactions" class="dash-card">
      <h2 class="dash-card__title">
        Последние реакции
        <span class="dash-card__total">Всего: <%= @reactions_total %> · за 7 дней: <%= @reactions_week %></span>
      </h2>
      <p class="dash-card__lead">
        Лайки статей и новостей. Одна реакция на IP: повторное нажатие снимает её,
        выбор другого вида заменяет прежний, поэтому это число читателей, а не просмотров.
      </p>

      <% if @reactions.any? %>
        <ul class="dash-list">
          <%= render partial: 'admin/dashboard/reaction', collection: @reactions, as: :reaction %>
        </ul>
        <p class="dash-card__footer dash-reaction-summary">
          По видам:
          <% @reaction_counts.each do |kind, count| %>
            <span class="dash-reaction-summary__item" title="<%= t("news.reactions.#{kind}") %>">
              <span aria-hidden="true"><%= ::PageReaction::KINDS[kind] %></span> <%= count %>
            </span>
          <% end %>
        </p>
      <% else %>
        <p class="dash-card__empty">Пока никто не отреагировал.</p>
      <% end %>
    </section>
  <% end %>

  <section class="dash-card">
    <h2 class="dash-card__title">Посещения за неделю</h2>
    <p class="dash-card__lead">
      Просмотры за сутки по JS-маячку: засчитываются только клиенты, исполнившие JavaScript на странице,
      поэтому скрейперы голого HTML не учитываются. «Подозрительные» — IP, сделавшие за день больше
      <%= ::PageVisits::SUSPICIOUS_DAY_LIMIT %> запросов.
    </p>
    <div class="dash-stat-grid">
      <% @week_visits.each do |name, days| %>
        <%= render 'admin/dashboard/stat_card', title: name, rows: days.to_a %>
      <% end %>
    </div>
  </section>

  <%= render 'admin/dashboard/day_stats', stats: @today_stats, title: 'Сегодня',
        note: 'Незакрытые сутки: цифры растут до полуночи по Москве.' %>

  <%= render 'admin/dashboard/day_stats', stats: @yesterday_stats, title: 'Вчера',
        note: 'Сутки закрыты, числа не меняются.' %>

  <% if @pages %>
    <section class="dash-card">
      <h2 class="dash-card__title">Недавно изменённые статьи</h2>
      <div class="dash-card__list">
        <%= render partial: 'admin/pages/page_item', collection: @pages, as: :page, locals: { visits: @page_visits || {}, parent_titles: {} } %>
      </div>
      <p class="dash-card__footer"><%= link_to 'Все статьи →', admin_pages_path %></p>
    </section>
  <% end %>

  <% if @users_total %>
    <section class="dash-card">
      <h2 class="dash-card__title">Пользователи</h2>
      <p class="dash-card__lead">
        Всего: <%= @users_total %>.
        <% if @users_pending > 0 %>
          <%= link_to "Не подтвердили почту: #{@users_pending}", admin_users_path(filter: 'not_activated') %>
        <% end %>
      </p>
      <ul class="dash-list dash-list--users">
        <% @users_new.each do |user| %>
          <li class="dash-list__row">
            <span class="dash-list__main">
              <%= link_to user.name, edit_admin_user_path(user) %>
              <span class="dash-list__sub"><%= user.email %></span>
            </span>
            <span class="dash-list__meta"><%= admin_time(user.created_at) %></span>
            <span class="dash-badges"><%= admin_user_badges(user) %></span>
          </li>
        <% end %>
      </ul>
    </section>
  <% end %>
</div>

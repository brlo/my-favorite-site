<% @page_title = 'Сводка' %>

<h1>Сводка</h1>

<h2>Посещения за неделю</h2>
<p class="muted">HTML-просмотры за сутки. «Подозрительные» — IP, сделавшие за день больше <%= ::PageVisits::SUSPICIOUS_DAY_LIMIT %> запросов (скрейперы с обычными браузерными User-Agent).</p>
<div class="stats">
  <% @week_visits.each do |name, days| %>
    <div>
      <div class="hint"><%= name %></div>
      <table>
        <% days.each do |date, visits| %>
          <tr><td class="muted"><%= date %></td><td><%= visits %></td></tr>
        <% end %>
      </table>
    </div>
  <% end %>
</div>

<h2>Вчера, <%= @yesterday.strftime('%d.%m.%Y') %></h2>
<div class="stats">
  <% if @day_bots.any? %>
    <div>
      <div class="hint">Топ ботов (запросов)</div>
      <table>
        <% @day_bots.first(10).each do |name, count| %>
          <tr><td class="muted"><%= name %></td><td><%= count %></td></tr>
        <% end %>
      </table>
    </div>
  <% end %>

  <% if @day_langs.any? %>
    <div>
      <div class="hint">Языки интерфейса (люди)</div>
      <table>
        <% @day_langs.first(10).each do |lang, count| %>
          <tr><td class="muted"><%= lang %></td><td><%= count %></td></tr>
        <% end %>
      </table>
    </div>
  <% end %>

  <% if @day_top_ips.any? %>
    <div>
      <div class="hint">Топ IP (без ботов)</div>
      <table>
        <% @day_top_ips.each do |ip, count| %>
          <tr><td class="muted"><%= ip %></td><td><%= count %></td></tr>
        <% end %>
      </table>
    </div>
  <% end %>

  <% if @day_top_pages && @day_top_pages.any? %>
    <div>
      <div class="hint">Популярные статьи (без ботов)</div>
      <table>
        <% @day_top_pages.each do |title, count| %>
          <tr><td class="muted"><%= title %></td><td><%= count %></td></tr>
        <% end %>
      </table>
    </div>
  <% end %>
</div>

<% if @pages %>
  <h2>Недавно изменённые статьи</h2>
  <%= render partial: 'admin/pages/page_item', collection: @pages, as: :page, locals: { visits: @page_visits || {}, parent_titles: {} } %>
  <p><%= link_to 'Все статьи →', admin_pages_path %></p>
<% end %>

<% if @users_total %>
  <h2>Пользователи</h2>
  <p>
    Всего: <%= @users_total %>.
    <% if @users_pending > 0 %>
      <%= link_to "Не подтвердили почту: #{@users_pending}", admin_users_path(filter: 'not_activated') %>
    <% end %>
  </p>
  <div class="table-wrap">
    <table class="admin-table">
      <tr><th>Новые</th><th>Почта</th><th>Создан</th><th></th></tr>
      <% @users_new.each do |user| %>
        <tr>
          <td><%= link_to user.name, edit_admin_user_path(user) %></td>
          <td><%= user.email %></td>
          <td><%= admin_time(user.created_at) %></td>
          <td><%= admin_user_badges(user) %></td>
        </tr>
      <% end %>
    </table>
  </div>
<% end %>

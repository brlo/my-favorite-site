<%= content_for :title, "#{@project.title} — Часть #{@part}" %>



<section id="page-content" class="looks-like-page text-page" itemscope="" itemtype="http://schema.org/Article">

<div id="chapter-header" data-controller="menu-filter">
  <h2 class="parent-title">
    <%= link_to 'Совместные переводы церковных текстов', translation_projects_path %>
  </h2>

  <div id="h1-title">
    <h1
      class="title"
      id="current-address"
      data-book-short-name="<%= request.path %>"
      data-lang-ui="<%= I18n.locale %>"
      data-lang-content="<%= @lang_to %>"
      data-book-code=""
      data-page-path=""
      data-disable-chapters="<%= @is_disable_chapters ? 1 : 0 %>"
      data-chapter="<%= @part %>"
      itemprop="headline"
    >
      <%= @project.title %>
    </h1>
  </div>

  <div id="title-sub">
    <strong><%= translation_lang_by_code(@project.source_langs.first) %> → <%= translation_lang_by_code(@lang_to) %></strong><br>
    Этот перевод подготавливается пользователями сайта bibleox.com.<br>
    <% if !logged_in? %> Вы можете помочь улучшить этот текст! <%= link_to 'Зарегистрируйтесь', signup_path %> и присоединяйтесь к работе над <%= link_to 'переводом', translation_project_path(@project, part: @part, lang_to: @lang_to) %>. <br><% end %>
    Как и материалы Wikipedia,
      <%= link_to 'результат', result_translation_project_path(part: @part, lang_to: @lang_to), data: {turbo: false} %>
    распространяется свободно под лицензией CC BY-SA.
  </div>

  <div class='small hint' style='text-align: center'>Часть</div>
  <nav id='menu-chapters'>
    <% prev_chapter = @part - 1 %>
    <% now_chapter = @part %>
    <% next_chapter = @part + 1 %>
    <% @all_parts.each do |i| %>
      <% classes = "chapter-num" %>
      <% i == now_chapter ? classes = ' selected' : nil %>
      <a id="ch-<%= i %>" data-chapter="<%= i %>" class="<%= classes %>" href="<%= translation_project_path(@project, part: i, lang_to: @lang_to) %>"><%= i %></a>
    <% end %>
  </nav>

  <div id="text-bar-wrapper">
    <div class='bar-description'>С какого на какой язык переводить:</div>
    <div id='text-bar'>
      <div class='bar-el'>
        <div class='lang-select'
          data-controller='choices-select'
          data-choices-select-placeholder-value='Перевод с языков'
          data-choices-select-search-enabled-value='true'
          data-choices-select-position-value='down'>

          <select id="page-lang-select" data-page='true' class='search-select'>
            <% langs_for_translates(is_with_encient: true).each do |lang, name| %>
              <% next unless @langs_from.include?(lang) %>
              <option value='<%= translation_project_path(part: @part, lang_to: lang) %>' <% if @langs_from.last == lang %>selected<% end %>><%= name %></option>
            <% end %>
          </select>
        </div>
      </div>

      <div class='bar-el'>
        →
      </div>

      <div class='bar-el'>
        <div class='lang-select'
          data-controller='choices-select'
          data-choices-select-placeholder-value='Перевод на язык'
          data-choices-select-search-enabled-value='true'
          data-choices-select-position-value='down'
          data-action='change->choices-select#selectLink'>

          <select id="page-lang-select" data-page='true' class='search-select'>
            <% langs_for_translates(is_with_encient: false).each do |lang, name| %>
              <% next if @project.source_langs.to_a.include?(lang) %>
              <option value='<%= translation_project_path(part: @part, lang_to: lang) %>' <% if @lang_to == lang %>selected<% end %>><%= name %></option>
            <% end %>
          </select>
        </div>
      </div>

      <div class='right-group'>
        <% if current_user&.is_admin? %>
          <div class='bar-el btn'>
            <%= link_to '✕', translation_project_path(@project, part: @part),
              method: :delete,
              data: {
                turbo_method: :delete,
                turbo_confirm: "Уверен, что хочешь удалить часть #{ @part } проекта перевода? '#{@project.title}'"
            } %>
          </div>
          <div class='bar-el btn'>
            <%= link_to '✏️', edit_translation_project_path(@project) %>
          </div>
        <% end %>

        <div class='bar-el btn' data-controller='share-btn' data-action='click->share-btn#share'>
          <a class='share-btn'>
            <svg style="width: 15px;" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6">
              <path stroke-linecap="round" stroke-linejoin="round" d="M7.217 10.907a2.25 2.25 0 1 0 0 2.186m0-2.186c.18.324.283.696.283 1.093s-.103.77-.283 1.093m0-2.186 9.566-5.314m-9.566 7.5 9.566 5.314m0 0a2.25 2.25 0 1 0 3.935 2.186 2.25 2.25 0 0 0-3.935-2.186Zm0-12.814a2.25 2.25 0 1 0 3.933-2.185 2.25 2.25 0 0 0-3.933 2.185Z" />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </div>

</div>

<div class="translation-stats">
  <div class="result-link">
    <%= link_to result_translation_project_path(part: @part, lang_to: @lang_to), data: {turbo: false} do %>
      Посмотреть итоговый перевод
    <% end %>
  </div>
  <div class="progress-section">
    <div class="progress-label">
      <span>Прогресс перевода</span>
      <span><%= @progress_percent %>%</span>
    </div>
    <div class="progress-bar-container">
      <div class="progress-bar-fill" style="width: <%= @progress_percent %>%;"></div>
    </div>
  </div>
</div>

<% if @segments.any? %>
<div class="translations-feed" data-controller="translations">
  <%= turbo_frame_tag "translations_feed" do %>
    <div class="feed-grid" data-controller='share-links-replace'>
      <% @segments.each do |segment| %>
        <%= render partial: "translations/segment_with_translations",
                   locals: { segment: segment } %>
      <% end %>
    </div>
  <% end %>
</div>
<% else %>
  <div>Текст ещё не загружен. Попробуйте зайти через 15 минут.</div>
<% end %>


<%= content_for :title, t('tr_projects.edit_project') %>

<div class="container py-4">
  <div class="row justify-content-center">
    <div class="col-lg-8">

      <div class="card">
        <div class="card-header">
          <h1><%= t('tr_projects.edit_project') %></h1>

          <%= link_to t('tr_projects.delete'), translation_project_path(@project),
            method: :delete,
            data: {
              turbo_method: :delete,
              turbo_confirm: t('tr_projects.confirm_delete_project', title: @project.title)
          } %>
        </div>
        <div class="card-body">
          <%= render 'form', project: @project %>
        </div>
      </div>

    </div>
  </div>
</div>


<div class="card border-primary">
  <h2 class="mb-0"><%= t('tr_projects.import_title') %></h2>
    <%= form_with url: import_content_translation_project_path(@project), method: :post, local: true do |f| %>

      <%= render 'layouts/errors', ar_object: @project %>

      <div>
        <%= f.label :lang, t('tr_projects.source_lang') %>
        <%= f.select :lang,
            langs_for_translates(is_with_encient: true).map {|k,v| [v,k]},
            { selected: 'ru' },
            {
              class: 'search-select form-select'
            }
        %>
      </div>

      <%= render 'shared/tiptap_editor', form: f, field_name: :html_content, initial_value: "" %>

      <div class="d-flex gap-2">
        <%= f.submit t('tr_projects.split_and_add'),
            class: 'btn btn-primary',
            data: { disable_with: t('tr_projects.processing') } %>
      </div>
    <% end %>
  </div>
</div>

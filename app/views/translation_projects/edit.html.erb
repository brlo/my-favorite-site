<%= content_for :title, 'Редактировать проект' %>

<div class="container py-4">
  <div class="row justify-content-center">
    <div class="col-lg-8">

      <div class="card">
        <div class="card-header">
          <h1>Редактировать проект</h1>

          <%= link_to 'Удалить', translation_project_path(@project),
            method: :delete,
            data: {
              turbo_method: :delete,
              turbo_confirm: "Уверены, что хотите удалить проект перевода? '#{@project.title}'"
          } %>
        </div>
        <div class="card-body">
          <%= render 'form', project: @project %>
        </div>
      </div>

    </div>
  </div>
</div>


<div class="card border-primary">
  <h2 class="mb-0">Импортировать новую часть текста</h2>
    <%= form_with url: import_content_translation_project_path(@project), method: :post, local: true do |f| %>

      <%= render 'layouts/errors', ar_object: @project %>

      <div>
        <%= f.label :lang_to, 'Язык оригинала' %>
        <%= f.select :lang_to,
            langs_for_translates.keys.map { |lang| [page_lang_string_full(lang), lang] },
            { selected: 'ru' },
            {
              class: 'search-select form-select'
            }
        %>
      </div>

      <%= render 'shared/tiptap_editor', form: f, field_name: :html_content, initial_value: "" %>

      <div class="d-flex gap-2">
        <%= f.submit 'Разбить и добавить',
            class: 'btn btn-primary',
            data: { disable_with: 'Обработка...' } %>
      </div>
    <% end %>
  </div>
</div>

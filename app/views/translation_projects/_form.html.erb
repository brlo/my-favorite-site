<%= form_with model: project, local: true do |f| %>
  <%= render 'layouts/errors', ar_object: project %>

  <div>
    <%= f.label :title, t('tr_projects.form.title') %>
    <%= f.text_field :title, required: true, maxlength: 200 %>
  </div>

  <div>
    <%= f.label :description, t('tr_projects.form.description') %>
    <%= f.text_area :description, rows: 4, placeholder: t('tr_projects.form.description_placeholder') %>
  </div>

  <div>
    <%= f.label :page_ids, t('tr_projects.form.page_ids') %>
    <%= f.text_field :page_ids,
                     value: f.object.page_ids&.join(','),
                     placeholder: t('tr_projects.form.page_ids_placeholder'),
                     class: 'form-control' %>
  </div>

  <div>
    <%= f.submit project.new_record? ? t('tr_projects.form.create') : t('tr_projects.form.save'),
        class: 'btn btn-primary',
        data: { disable_with: t('tr_projects.form.saving') } %>
  </div>
<% end %>

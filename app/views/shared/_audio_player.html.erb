<%# Плеер внизу экрана. Один на сайт: переживает переходы Turbo (data-turbo-permanent), наполняется из JS (lib/audio_engine.js) %>
<div id="audio-player" data-turbo-permanent data-controller="audio-player" hidden
     data-audio-player-label-play-value="<%= t('audio.play', default: 'Play') %>"
     data-audio-player-label-pause-value="<%= t('audio.pause', default: 'Pause') %>">
  <div class="ap-inner">
    <div class="ap-row">
      <div class="ap-controls">
        <button type="button" class="ap-btn ap-skip" data-action="audio-player#back" aria-label="<%= t('audio.back', default: '-15 s') %>">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5V2L7 6l5 4V7a6 6 0 1 1-6 6H4a8 8 0 1 0 8-8z" fill="currentColor"/></svg>
          <span>15</span>
        </button>
        <button type="button" class="ap-btn ap-play" data-audio-player-target="play" data-action="audio-player#toggle" aria-label="<%= t('audio.play', default: 'Play') %>">
          <svg class="ap-icon-play" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14l11-7z" fill="currentColor"/></svg>
          <svg class="ap-icon-pause" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 5h4v14H6zM14 5h4v14h-4z" fill="currentColor"/></svg>
          <svg class="ap-icon-wait" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="8" fill="none" stroke="currentColor" stroke-width="3" stroke-dasharray="30 20"/></svg>
        </button>
        <button type="button" class="ap-btn ap-skip" data-action="audio-player#forward" aria-label="<%= t('audio.forward', default: '+15 s') %>">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5V2l5 4-5 4V7a6 6 0 1 0 6 6h2a8 8 0 1 1-8-8z" fill="currentColor"/></svg>
          <span>15</span>
        </button>
      </div>

      <div class="ap-info">
        <span class="ap-title" data-audio-player-target="title"></span>
        <a class="ap-credit" data-audio-player-target="credit" target="_blank" rel="noopener" hidden></a>
      </div>

      <button type="button" class="ap-btn ap-rate" data-audio-player-target="rate" data-action="audio-player#cycleRate" aria-label="<%= t('audio.speed', default: 'Speed') %>">1×</button>
      <button type="button" class="ap-btn ap-close" data-action="audio-player#close" aria-label="<%= t('audio.close', default: 'Close') %>">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" fill="none"/></svg>
      </button>
    </div>

    <div class="ap-row ap-progress">
      <span class="ap-time" data-audio-player-target="current">0:00</span>
      <input type="range" class="ap-seek" min="0" max="0" step="1" value="0"
             data-audio-player-target="seek"
             data-action="input->audio-player#seeking change->audio-player#seek"
             aria-label="<%= t('audio.seek', default: 'Position') %>">
      <span class="ap-time" data-audio-player-target="duration">0:00</span>
    </div>
  </div>
</div>

<div style='max-width:450px; margin: 20px auto;'>
  <h2><%= t('users.titles.password_change') %></h2>

  <%= form_tag update_password_users_path, method: :patch, local: true do %>
    <%= render 'layouts/errors', ar_object: @user %>

    <div class="mb-3">
      <%= label_tag :current_password, t('users.fields.current_password') %>
      <%= password_field_tag :current_password, nil, class: 'form-control', required: true %>
    </div>

    <div class="mb-3">
      <%= label_tag :new_password, t('users.fields.new_password') %>
      <%= password_field_tag :new_password, nil, class: 'form-control', required: true %>
    </div>

    <div class="mb-3">
      <%= label_tag :new_password_confirmation, t('users.fields.new_password_confirmation') %>
      <%= password_field_tag :new_password_confirmation, nil, class: 'form-control', required: true %>
    </div>

    <%= submit_tag t('users.buttons.save_new_password'), class: 'btn btn-warning' %>
  <% end %>
</div>

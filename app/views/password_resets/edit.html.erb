<div style='max-width:450px; margin: 20px auto;'>
  <h1><%= t('users.titles.new_password') %></h1>
  <%= form_for @user, :url => password_reset_path(@token), :html => {:method => :put} do |f| %>
    <%= render 'layouts/alerts', ar_object: @user %>

    <div class="field">
      <%= f.label :email %>
      <%= @user.email %>
    </div>
    <div class="field">
      <%= f.label :password %>
      <%= f.password_field :password %>
    </div>
    <div class="field">
      <%= f.label :password_confirmation %>
      <%= f.password_field :password_confirmation %>
    </div>
    <div class="actions">
      <%= f.submit t('users.buttons.new_password') %>
    </div>
  <% end %>
</div>

<div style='max-width:450px; margin: 20px auto;'>
  <h1><%= t('users.titles.login') %></h1>

  <%= form_with model: @session, url: login_path(locale: I18n.locale), method: :post, local: true do |f| %>
    <%= render 'layouts/alerts', ar_object: @session %>

    <div>
      <%= f.label :email %>
      <%= f.text_field :email, required: true %>
    </div>

    <div>
      <%= f.label :password %>
      <%= f.password_field :password, required: true %>
    </div>

    <div>
      <%= f.check_box :remember_me %>
      <%= f.label :remember_me %>
    </div>

    <div>
      <%= f.submit %>
    </div>
  <% end %>

  <p><%= t('users.is_not_yet_registred') %> <%= link_to t('users.buttons.signup'), signup_path %></p>
  <%= link_to t('users.is_forgot_password'), new_password_reset_path %>
</div>

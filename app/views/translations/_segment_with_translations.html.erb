<% lang_to = @lang_to || @translation&.lang %>

<%= turbo_frame_tag "segment-with-translations-#{segment.id}" do %>
  <div class="segment-card">
    <div class="original-text">
      <div class="segment-content">
        <div class="segment-meta">
          <% fragment_id = "ch#{ segment.chapter }-p#{ segment.paragraph }-l#{ segment.line }" %>
          <span id='<%= fragment_id %>' data-share-id='<%= fragment_id %>' class='fragment-number'>#<%= fragment_id %></span>
          <div class='html-tags'>
            <% segment.open_tags.map { it['n'] }.each do |tag| %>
              <span class="tag"><%= t("open_tags.#{tag}", default: tag) %></span>
            <% end %>
            <% close_tags = segment.close_tags.map { it['n'] }.each do |tag| %>
              <span class="tag"><%= t("close_tags.#{tag}", default: "/#{tag}") %></span>
            <% end %>
          </div>
        </div>

        <div class='translations-from'>
          <% if @params_lang_from.include?(segment.lang) %>
            <div class='translation translate-from origin'>
              <div class='meta'>
                <div class="translations-lang">
                  <%= translation_lang_by_code(segment.lang) %> <span class='origin-badge'>исходник</span>
                </div>
              </div>
              <div class='text'>
                <%= segment.text %>
              </div>
            </div>
          <% end %>

          <% ::TranslationsService.group_by_lang_and_sort_by_priority(segment.translations).values_at(*@params_lang_from).compact.each do |translations| %>
            <% best_translation_for_lang = translations.first %>
            <div class='translation translate-from'>
              <div class='meta'>
                <div class="translations-lang">
                  <%= translation_lang_by_code(best_translation_for_lang.lang) %>
                </div>
                <div class='author'>
                  <%= best_translation_for_lang.user.name %> (@<%= best_translation_for_lang.user.username %>)
                </div>
              </div>
              <div class='text'>
                <%= best_translation_for_lang.text %>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <div class="translations-area" data-controller="translation-form">
      <div class="translations-meta">
        Переводы: <%= translation_lang_by_code(lang_to) %>
      </div>

      <div class="translations-list" id="translations_list_<%= segment.id %>">
        <% if logged_in? %>
          <% is_user_already_make_translation = !!segment.translations.to_a.find { it.user_id == current_user.id } %>
        <% end %>
        <% translations = segment.translations.select { it.lang == lang_to } %>
        <% ::TranslationsService.sort_by_priority(translations).each.with_index do |translation, index| %>
          <%= render partial: "translations/translation_card",
                     locals: { translation:, segment:, index:, is_user_already_make_translation: } %>
        <% end %>
      </div>

      <% if logged_in? %>
        <%= link_to "Предложить перевод",
          new_translation_project_segment_translation_path(
            translation_project_id: segment.translation_project_id,
            segment_id: segment.id,
            lang_to: lang_to
          ),
          data: {
            turbo_stream: true,
            turbo_prefetch: false
          },
          class: "btn-propose" %>

        <span id="new_translation_form_<%= segment.id %>"></span>
      <% else %>
        <small>Чтобы предлагать переводы надо <%= link_to 'зарегистрироваться', login_path, data: {turbo: false} %></small>
      <% end %>
    </div>
  </div>
<% end %>

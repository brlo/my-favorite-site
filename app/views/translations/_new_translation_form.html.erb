<div class="translation-form-container" data-translation-form-target="formContainer">
  <div class="translation-form-card">
    <div class="form-header">
      <h5><%= t('tr_projects.your_translation') %></h5>
      <%= link_to "✕", "#",
                  data: { action: "click->translation-form#hideForm" },
                  class: "close-btn" %>
    </div>

    <%= render 'layouts/errors', ar_object: translation %>

    <%= form_with model: translation,
                  url: translation_project_segment_translations_path(
                    translation_project_id: translation.translation_project_id,
                    segment_id: translation.segment_id,
                    lang_from: params[:lang_from]
                  ),
                  data: {
                    turbo_frame: "translations_list_#{translation.segment_id}"
                  },
                  class: "inline-form" do |f| %>

      <%= f.text_area :text,
                      placeholder: t('tr_projects.text_placeholder'),
                      rows: 3,
                      class: "translation-input",
                      autofocus: true %>

      <%= f.text_area :sub_text,
                      placeholder: t('tr_projects.sub_text_placeholder'),
                      rows: 1,
                      class: "translation-input" %>

      <%= f.hidden_field :lang, value: params[:lang_to] || translation.lang %>

      <div class="form-actions">
        <%= f.submit t('tr_projects.submit'), class: "btn-submit" %>
      </div>
    <% end %>
  </div>
</div>

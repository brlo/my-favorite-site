<!DOCTYPE html>
<html lang="<%= ::I18n.locale.to_s %>" dir="<%= ui_direction %>">
  <head>
    <meta charset="UTF-8">
    <% if @canonical_url.present? %>
    <link rel="canonical" href="<%= @canonical_url %>">
    <% end %>
    <title><%= @page_title %> / <%= I18n.t('title') %></title>
    <% if @no_index == true %>
    <meta name="robots" content="noindex, follow">
    <% end %>
    <meta name="description" content="<%= @meta_description %>">
    <meta name="viewport" content="width=device-width,initial-scale=1,minimum-scale=0.5,maximum-scale=1.5">
    <meta property="og:site_name" content="<%= I18n.t('title') %>">
    <meta property="og:title" content="<%= @page_title %> / <%= I18n.t('title') %>">
    <meta property="og:description" content="<%= @meta_description %>">
    <script type="application/ld+json"><%= raw JSON.generate({"@context" => "https://schema.org", "@type" => "WebSite", "name" => I18n.t('title'), "url" => "https://bibleox.com/"}) %></script>
<%= content_for?(:head) ? yield(:head) : '' %>
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">

    <link rel="apple-touch-icon" sizes="180x180" href="<%= my_res_link_to('/favicons/apple-touch-icon.png') %>">
    <link rel="icon" type="image/png" sizes="96x96" href="<%= my_res_link_to('/favicons/favicon-96x96.png') %>">
    <link rel="icon" type="image/svg+xml" href="<%= my_res_link_to('/favicons/favicon.svg') %>">
    <link rel="shortcut icon" href="<%= my_res_link_to('/favicons/favicon.ico') %>">

    <link rel="manifest" href="<%= my_res_link_to('/favicons/site.webmanifest') %>">
    <link rel="mask-icon" href="<%= my_res_link_to('/favicons/safari-pinned-tab.svg') %>" color="#f6f4e5">
    <meta name="apple-mobile-web-app-title" content="Bibleox">
    <meta name="application-name" content="Bibleox">
    <meta name="apple-mobile-web-app-status-bar-style" content="#f6f4e5">
    <meta name="msapplication-TileColor" content="#f6f4e5">
    <meta name="msapplication-config" content="<%= my_res_link_to('/favicons/browserconfig.xml') %>">
    <meta name="theme-color" content="#f6f4e5">

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <% if @content_lang == 'jp-box' %><meta name="turbo-cache-control" content="no-cache"><% end %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <style type="text/css">
      @font-face {font-family: 'Ponomar';src: url('<%= my_res_link_to('/fonts/PonomarUnicode.otf') %>') format("opentype");font-display: swap;}
    </style>
    <%= javascript_importmap_tags %>
  </head>

  <body
    class="<%= 'night-mode' if @is_night_mode %>"
    <% if @content_lang == 'jp-box' %>data-calque="<%= calque_orthodox? ? 'orthodox' : 'common' %>"<% end %>
    data-controller="books-menu metrics landing visit-beacon bib-notes<%= ' chat-unread' if chat_notification_member %>"
    data-action="click->books-menu#clickOutside"
    data-chat-unread-url-value="<%= chat_unread_path(locale: I18n.locale) %>"
    data-chat-unread-interval-value="60000"
    data-chat-unread-title-value="<%= t('chat.unread_new') %>"
    data-chat-unread-reply-title-value="<%= t('chat.unread_reply') %>"
    data-visit-page-id="<%= @page&.id || 0 %>"
    data-visit-lang="<%= I18n.locale %>"
    data-visit-token="<%= ::PageVisits.visit_token(@page&.id || 0) %>"
    data-reading-book="<%= @reading_bible_book %>"
    data-reading-lang="<%= @reading_bible_book ? current_bib_lang() : '' %>"
    data-reading-token="<%= @reading_bible_book ? ::PageVisits.bible_visit_token(@reading_bible_book) : (@page&.id ? ::PageVisits.visit_token(@page.id) : '') %>">

    <header>
      <div class="container">
        <div class="logo">
          <a href="<%= my_bib_link_to("/") %>">
            <img src="<%= my_res_link_to("/logo/bibleox.png") %>">
          </a>
        </div>

        <%= render 'shared/ui_lang' %>

        <nav>
          <a href="<%= my_bib_link_to("/") %>" id="bible-link" data-action="books-menu#show" class="local <%= @current_menu_item == 'biblia' ? ' selected' : nil %>"><%= I18n.t('menu.bible') %></a>
          <a href="<%= my_lang_page_link_to('links') %>" id="quotes-link" class="<%= @current_menu_item == 'links' ? ' selected' : nil %>"><%= I18n.t('menu.links') %></a>
          <%= chat_unread_link %>
          <div id="more-btn" data-controller="more-menu" data-action="click@window->more-menu#clickOutside">
            <a class="local more-dots"
              title="<%= t('menu.more') %>"
              aria-label="<%= t('menu.more') %>"
              data-action="click->more-menu#toggle"
              data-more-menu-target="button">⋯</a>

            <div id="more-area" class="hidden" data-more-menu-target="menu">
              <% if (church_page = header_church_page) %>
                <%= link_to church_page.title, my_page_link_to("/#{CGI.escape(church_page.path)}", page_lang: church_page.lang) %>
              <% end %>
              <%= link_to t('menu.chat'), chat_path(locale: ::I18n.locale), class: (@current_menu_item == 'chat' ? 'selected' : nil) %>
              <%= link_to t('menu.news'), news_path(locale: ::I18n.locale), id: 'news-link',
                    class: (@current_menu_item == 'news' ? 'selected' : nil) %>
              <%= link_to t('menu.translates'), translation_projects_path(locale: ::I18n.locale), class: (@current_menu_item == 'translates' ? 'selected' : nil) %>
              <a href="<%= my_lang_page_link_to('help') %>"><%= t('menu.help_site') %></a>
            </div>
          </div>

          <div id="settings-btn" data-controller="settings" data-action="click@window->settings#clickOutside">

            <% if logged_in? %>
              <%= link_to current_user.name.to_s, profile_path, class: 'profile_link' + (@current_menu_item == 'users' ? ' selected' : '') %>
            <% else %>
              <%= link_to t('users.links.login'), login_path, class: 'login_link'  + (@current_menu_item == 'users' ? ' selected' : '') %>
            <% end %>

            <a class="local"
              data-action="click->settings#toggleMenu"
              data-settings-target="button">
              <%= ::I18n.t('menu.settings') %>
            </a>

            <div id="settings-area"
                class="hidden"
                data-settings-target="menu">
              <el>
                <label>
                  <%= ::I18n.t('settings.color_scheme') %>:
                </label>
                <div class="switcher">
                  <a id="night-mode-switcher"
                    class="local"
                    data-action="click->settings#toggleNightMode"
                    data-settings-target="nightModeSwitcher">
                    <%= @is_night_mode ? ::I18n.t('menu.night') : ::I18n.t('menu.day') %>
                  </a>
                </div>
              </el>
              <el>
                <label>
                  <%= ::I18n.t('settings.font_size') %>:
                </label>
                <div class="switcher">
                  <div id="text-menu">
                    <a id="text-small-btn"
                      data-action="click->settings#textSizeClicked"
                      data-settings-target="textSmallBtn">А</a>
                    <a id="text-medium-btn"
                      data-action="click->settings#textSizeClicked"
                      data-settings-target="textMediumBtn">А</a>
                    <a id="text-large-btn"
                      data-action="click->settings#textSizeClicked"
                      data-settings-target="textLargeBtn">А</a>
                  </div>
                </div>
              </el>
            </div>
          </div>

        </nav>
      </div>
    </header>

    <div class="flex-wrap menu-wrap">
      <div class="content" style="margin: 0; padding: 0 10px;">
        <% locale = I18n.locale %>
        <nav id="menu-books"
            class="menu-books hidden"
            data-books-menu-target="menu">

          <form action="/<%= I18n.locale %>/search"
                class="search-form"
                data-controller="search"
                data-action="submit->search#submit">

            <input class="search-tree-input"
                  type="text"
                  id="filter-books"
                  value=""
                  placeholder="<%= t('fast_search') %>"
                  autocomplete="off"
                  minlength="1"
                  required
                  data-books-menu-target="searchInput"
                  data-action="input->books-menu#filter"
                  data-search-target="input"
                  data-search-locale-value="<%= I18n.locale %>">

            <button type="submit" class="search-icon">
              <svg width="20" height="20" viewBox="0 0 20 20">
                <path d="M14.386 14.386l4.0877 4.0877-4.0877-4.0877c-2.9418 2.9419-7.7115 2.9419-10.6533 0-2.9419-2.9418-2.9419-7.7115 0-10.6533 2.9418-2.9419 7.7115-2.9419 10.6533 0 2.9419 2.9418 2.9419 7.7115 0 10.6533z" stroke="currentColor" fill="none" fill-rule="evenodd" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
            </button>
          </form>

          <div class="bible-list overtop">
            <!-- Ветхий и Новый Завет -->
            <div class="bible-column menu-tree">
              <div class="small hint"><%= I18n.t('menu.nov_zavet') %></div>
              <% ::BOOKS.each do |book_code, data| %>
                <% next if data[:zavet] == 1 %>
                <% m_classes = [] %>
                <% @book_code == book_code ? m_classes.push('selected') : nil %>
                <% data[:desc] == 'Евангелие' ? m_classes.push('gold') : nil %>
                <% data[:is_kanon] ? classes = 'kanon' : classes = 'non-kanon' %>

                <div class="menu-unit menu-link <%= m_classes.join(' ') %>">
                  <a class="<%= classes %>"
                    href="<%= "/#{locale}/#{current_bib_lang}/#{book_code}/1/" %>"
                    title="<%= data[:desc] %>"
                    data-books-menu-target="bookLink">
                    <span><%= ::I18n.t("books.mid.#{book_code}", locale: @locale_by_bib) %></span>
                  </a>
                </div>
              <% end %>
            </div>

            <!-- Аналогично для Ветхого Завета -->
            <div class="bible-column menu-tree">
              <div class="small hint"><%= I18n.t('menu.veth_zavet') %></div>
              <% ::BOOKS.each do |book_code, data| %>
                <% next if data[:zavet] == 2 %>
                <% m_classes = [] %>
                <% @book_code == book_code ? m_classes.push('selected') : nil %>
                <% book_code == 'ps' ? m_classes.push('gold') : nil %>
                <% data[:is_kanon] ? classes = 'kanon' : classes = 'non-kanon' %>

                <div class="menu-unit menu-link <%= m_classes.join(' ') %>">
                  <a class="<%= classes %>"
                    href="<%= "/#{locale}/#{current_bib_lang}/#{book_code}/1/" %>"
                    title="<%= data[:desc] %>"
                    data-books-menu-target="bookLink">
                    <span><%= ::I18n.t("books.mid.#{book_code}", locale: @locale_by_bib) %></span>
                  </a>
                </div>
              <% end %>
            </div>
          </div>

        </nav>

      </div>
    </div>


<% if @breadcrumbs.present? %>
  <div class="flex-wrap breadcrumbs-wrap">
    <div class="content">
      <nav class="breadcrumbs">
      <% @breadcrumbs.each.with_index do |(title, path), i| %>
        <% if path.present? %>
          <a href="<%= path %>"><%= title %></a>
        <% else %>
          <%= title %>
        <% end %>
        <%= (i+1) == @breadcrumbs.size ? '' : ' » ' %>
      <% end %>
      </nav>
    </div>
  </div>
<% end %>

<%= content_for?(:img_header) ? yield(:img_header) : '' %>

    <div id="flash-container" class="flash-messages" data-controller="flash">
      <% if notice %>
        <div class="flash notice"><%= notice %></div>
      <% end %>
      <% if alert %>
        <div class="flash alert"><%= alert %></div>
      <% end %>
    </div>

    <div class="flex-wrap">
      <div class="content main">
        <%= yield %>
      </div>
    </div>

    <footer>
      <div class="container">
        <dd>2022-<%= Date.today.strftime('%Y') %> <%= I18n.t('years_from') %></dd>
        <dd><%= ::I18n.t('about_site_short') %></dd>
        <dd><a title="<%= day_count() %>" href="<%= my_link_to('/about/') %>"><%= I18n.t('about_site') %></a></dd>
        <dd><a href="https://www.rustore.ru/catalog/app/com.bibleox.app" target="_blank" rel="noopener"><%= I18n.t('android_app') %></a></dd>
      </div>
    </footer>

<%= render 'shared/audio_player' %>

<%= content_for?(:end_of_page) ? yield(:end_of_page) : '' %>
    <% if @no_index != true %>
    <% end %>
    <% if @content_lang == 'jp-box' %>
    <script>
      (function () {
        var KEY = 'calque';
        function cookieMode() {
          var m = document.cookie.match(/(?:^|;\s*)calque=([^;]+)/);
          return m && m[1] === 'orthodox' ? 'orthodox' : 'common';
        }
        function settle() {
          var el = document.body;
          if (!el || !el.dataset.calque) return;
          var param = new URLSearchParams(window.location.search).get('calque');
          var want = null;
          try { want = localStorage.getItem(KEY); } catch (e) {}
          if (!want) want = (param === 'orthodox' || param === 'common') ? param : cookieMode();
          if (want === el.dataset.calque) return;
          var url = new URL(window.location.href);
          url.searchParams.set('calque', want);
          window.location.replace(url.toString());
        }
        document.addEventListener('DOMContentLoaded', settle);
        document.addEventListener('turbo:load', settle);
        window.addEventListener('pageshow', settle);
        document.addEventListener('click', function (e) {
          var btn = e.target.closest && e.target.closest('#btn-calque');
          if (!btn) return;
          var m = (btn.getAttribute('href') || '').match(/calque=(orthodox|common)/);
          try { localStorage.setItem(KEY, m ? m[1] : 'orthodox'); } catch (err) {}
        }, true);
      })();
    </script>
  <% end %>
</body>
</html>

<div id="chapter-header" data-controller="menu-filter">

<%# ссылка на редактирование — только тем, кто может редактировать (страница не кэшируется целиком) %>
<% if logged_in? && current_user.admin_area_access? && current_user.allow_ip?(request.ip) && @page.editable_by?(current_user) %>
  <div class="page-edit-top">
    <a rel="nofollow" href="<%= edit_admin_page_path(@page, locale: nil) %>">✎ <%= I18n.t('quote_page.edit_link') %></a>
  </div>
<% end %>

<% if @page.cover? %>
  <% content_for(:img_header) do %>
  <div class="flex-wrap img-header-wrap">
    <div class="blured">
      <img src="<%= @page.cover.large.url %>" draggable="false" alt="<%= @page.title %>">
    </div>
    <div class="content">
      <div class="img-header <%= 'is-overlay' if @page.is_cover_overlay? %>">
        <img src="<%= @page.cover.large.url %>" draggable="false" alt="<%= @page.title %>">
        <% if @page.is_cover_overlay? %>
          <div class="cover-overlay" style="<%= cover_overlay_gradient_style(@page) %>">
            <div class="cover-overlay-caption" style="color: <%= @page.cover_overlay_text_color %>">
              <%= render(partial: 'pages/h1_title') %>
              <% if @parent_page.present? && @page.is_show_parent %>
                <div class="cover-overlay-divider"></div>
                <div class="cover-overlay-parent">
                  <a href="<%= my_page_link_to("/#{@parent_page.path}", page_lang: @parent_page.lang) %>"><%= @parent_page.title %></a>
                </div>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>
  <% end %>
<% end %>

  <%# при оверлее заголовок и родитель уже показаны на обложке, под ней не дублируем %>
  <% unless @page.is_cover_overlay? %>
    <% if @parent_page.present? && @page.is_show_parent %>
      <h2 class="parent-title">
        <a href="<%= my_page_link_to("/#{@parent_page.path}", page_lang: @parent_page.lang) %>"><%= @parent_page.title %></a>
      </h2>
    <% end %>

    <div id="h1-title">
      <%= render(partial: 'pages/h1_title') %>
    </div>
  <% end %>

  <% if @page.title_sub.present? %>
    <div id="title-sub"><%= @page.title_sub %></div>
  <% end %>

  <% if @page.links.present? %>
    <div id="links-sub">
      <div class="btn-group">
        <% @page.links.each do |k,v| %>
          <% if v.present? %>
            <a class="btn" href="<%= my_page_link_to(v, page_lang: @page.lang) %>"><%= k %></a>
          <% else %>
            <div class="btn pressed"><%= k %></div>
          <% end %>
        <% end %>
      </div>
    </div>
  <% end %>


<% if @tree_menu.present? %>
  <% if @page.is_search %>
    <form class="tree-search page-search-form" action="<%= my_page_link_to("/#{@page.path}/search", page_lang: @page.lang) %>">
      <div class="search-tree-input-area">
        <input
          class="pretty search-tree-input"
          name="t"
          type="text"
          minlength="1"
          required
          placeholder="<%= I18n.t("page.search_placeholder") %>"
          value=""
          autocomplete="off"
          data-action="input->menu-filter#filter"
          placeholder="Поиск по меню..."
          class="menu-search-input"
>
        <button type="submit" class="search-icon">
          <svg width="20" height="20" viewBox="0 0 20 20"><path d="M14.386 14.386l4.0877 4.0877-4.0877-4.0877c-2.9418 2.9419-7.7115 2.9419-10.6533 0-2.9419-2.9418-2.9419-7.7115 0-10.6533 2.9418-2.9419 7.7115-2.9419 10.6533 0 2.9419 2.9418 2.9419 7.7115 0 10.6533z" stroke="currentColor" fill="none" fill-rule="evenodd" stroke-linecap="round" stroke-linejoin="round"></path></svg>
        </button>
      </div>
    </form>
  <% end %>
<% end %>

<%= render(partial: 'pages/text_bar') %>

<% if @tree_menu.present? %>

  <div class="menu-tree <%= text_cont_classes %>" data-menu-filter-target="tree">
    <div>
      <%= render(partial: 'pages/menu', locals: {items: @tree_menu, depth: 0, page_lang: @page.lang}) %>
    </div>
  </div>

<% elsif @chapters.present? && @chapters.size > 1 %>
  <!-- Похожие мастериалы -->
  <div class="menu-tree <%= text_cont_classes %>">
    <div class="bar-description"><%= ::I18n.t('menu.same_subject') %></div>
    <div class="items">
      <% @chapters.each.with_index do |(title, path, is_gold), i| %>
        <% classes = "menu-unit menu-link" %>
        <% i == (@chapter_current-1) ? (classes += ' selected') : nil %>
        <% is_gold ? (classes += ' gold') : nil %>
        <div class="<%= classes %>">
          <a href="<%= my_page_link_to("/#{path}", page_lang: @page.lang) %>"><span><%= title %></span></a>
        </div>
      <% end %>
    </div>
  </div>

<% end %>
</div>

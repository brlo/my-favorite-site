<% menu_items = (@page || page).body_menu %>
<nav id="article-menu" aria-label="<%= I18n.t('page.menu_name') %>" class="collapsed"
     data-controller="auto-collapse" data-auto-collapse-max-height-value="900"
     data-auto-collapse-always-toggle-value="true">
  <button type="button" class="menu-toggle" aria-expanded="false" aria-controls="article-menu-list"
          data-auto-collapse-target="button" data-action="auto-collapse#toggle">
    <span><%= I18n.t('page.menu_name') %></span>
    <svg class="menu-toggle-chevron" width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 6l5 5 5-5"/></svg>
  </button>
  <div class="menu-list" id="article-menu-list" data-auto-collapse-target="content">
    <% menu_items.each do |el_name, el_anchor, el_text| %>
      <div class="nav-<%= el_name %> <%= toc_item_short?(el_text) ? 'short' : '' %>"><a href="#<%= el_anchor %>" data-turbo='false'><%= el_text %></a></div>
    <% end %>
  </div>
</nav>

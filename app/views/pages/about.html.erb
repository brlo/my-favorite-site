<% content_for(:head) do %>
  <meta property="og:image" content="<%= asset_path("bogoroditsa.webp") %>"/>
  <meta property="og:type" content="website"/>
  <meta property="og:url" content= "<%= @canonical_url %>" />
  <meta property="og:locale" content= "<%= ::I18n.locale %>" />

  <% ::ALL_LOCALES.each do |lang,_| %>
    <% next if ::I18n.locale.to_s == lang.to_s %>
    <meta property="og:locale:alternate" content= "<%= lang %>" />
  <% end %>

  <% ::ALL_LOCALES.each do |lang,_| %>
    <% next if ::I18n.locale.to_s == lang.to_s %>
    <link rel="alternate" hreflang="<%= lang %>" href="<%= "https://bibleox.com/#{lang}/about/" %>" />
  <% end %>
<% end %>

<% content_for(:img_header) do %>
<div class='flex-wrap img-header-wrap'>
    <div class='blured'>
  <%= image_tag('bogoroditsa.webp', draggable: 'false') %>
  </div>
  <div class="content">
    <div class='img-header'>
      <%= image_tag('bogoroditsa.webp', draggable: 'false') %>
    </div>
  </div>
</div>
<% end %>

<h1><%= I18n.t('about_site') %></h1>
<p><%= I18n.t('about_text') %></p>
<p><%= I18n.t('about_news') %>: <a href="https://t.me/bibleox">https://t.me/bibleox</a></p>
<p><%= I18n.t('about_contact') %>: <a href="https://t.me/rodion_orthodox">https://t.me/rodion_orthodox</a>, <a href="https://bibleox.com/ru/ru/w/родион-власов">https://bibleox.com/ru/ru/w/родион-власов</a></p>
<br>
<p><%= t('about_funding') %></p>
<p><%= t('about_prayer') %></p>
<p><%= t('about_donate_html', bank: tag.span(I18n.locale == :ru ? 'СБЕР' : 'SBER', style: 'color: #0D8523'), card: tag.strong('2202 2082 9863 8306')) %></p>
<p>SBER · RODION VLASOV</p>
<br><br>

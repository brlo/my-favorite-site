<div class="chat-invite" data-controller="chat-invite" data-action="keydown.esc->chat-invite#close">
  <div class="chat-invite__sentinel" data-chat-invite-target="sentinel" aria-hidden="true"></div>

  <div class="chat-invite-float" data-chat-invite-target="panel" hidden>
    <a class="page-chat-invite" href="<%= chat_path(locale: ::I18n.locale) %>">
      <span class="page-chat-invite__icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/>
          <path d="M8.5 8.5h7M8.5 12h4.5"/>
        </svg>
      </span>
      <span class="page-chat-invite__text"><%= ::I18n.t('quote_page.whant_to_fix') %></span>
      <span class="page-chat-invite__cta"><%= t('chat.invite_cta') %></span>
    </a>

    <button type="button" class="chat-invite-float__close"
            aria-label="<%= t('chat.invite_close') %>"
            data-action="chat-invite#close">
      <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
        <path d="M5 5l10 10M15 5L5 15"/>
      </svg>
    </button>
  </div>
</div>

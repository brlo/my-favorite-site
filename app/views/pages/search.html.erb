<% if @page.present? %>
  <% content_for(:head) do %>
    <% og_image = @page.cover? ? @page.cover.large.url : my_res_link_to(@page.img_preview_file_path) %>
    <meta property="og:image" content="<%= og_image %>"/>
    <meta property="og:image:width" content="1200"/>
    <meta property="og:image:height" content="630"/>
    <meta property="og:type" content="book"/>
    <% @meta_book_tags&.each do |tag| %>
    <meta property="og:book:tag" content="<%= tag %>"/>
    <% end %>
    <meta name="keywords" content="<%= @meta_book_tags&.join(', ') %>" />
    <meta property="og:url" content= "<%= @canonical_url %>" />
    <meta property="og:locale" content= "<%= current_lang() %>" />
    <meta property="og:locale:alternate" content= "<%= ::I18n.locale == :ru ? 'en' : 'ru' %>" />
  <% end %>

  <h2><%= t('page_search.title') %> "<a href="<%= my_page_link_to("/#{@page.path}", page_lang: @page.lang) %>"><%= @page.title %></a>"</h2>

  <form class='page-search-form' action="<%= my_page_link_to("/#{@page.path}/search", page_lang: @page.lang) %>">
    <div class='search-tree-input-area'>
      <input
        class='pretty search-tree-input'
        name='t'
        type='text'
        minlength="1"
        required
        placeholder='<%= I18n.t("page.search_placeholder") %>'
        value='<%= @search_text %>'
        autocomplete='off'
      />
      <button type="submit" class='search-icon'>
        <svg width="20" height="20" viewBox="0 0 20 20"><path d="M14.386 14.386l4.0877 4.0877-4.0877-4.0877c-2.9418 2.9419-7.7115 2.9419-10.6533 0-2.9419-2.9418-2.9419-7.7115 0-10.6533 2.9418-2.9419 7.7115-2.9419 10.6533 0 2.9419 2.9418 2.9419 7.7115 0 10.6533z" stroke="currentColor" fill="none" fill-rule="evenodd" stroke-linecap="round" stroke-linejoin="round"></path></svg>
      </button>
    </div>
  </form>
  <% if @matches_count%>
    <div class='hint'><%= t('search_page.matches') %>: <%= @matches_count %></div>
  <% end %>
  <hr>

  <article class='looks-like-page <%= text_size_class %>' id='search-results'>
    <% if @matches.any? %>
      <%= render partial: "pages/match", collection: @matches, as: :m %>
    <% else %>
      <div class='tip'><%= I18n.t('tips.page_search_was_return_zero_results') %></div>
    <% end %>
  </article>

  <% if @matches.any? && @matches.count == @per_page %>
    <div id='infinite-scroll-trigger'
      data-controller="infinite-scroll"
      data-infinite-scroll-url-value="<%= request.path %>?<%= request.query_parameters.except(:page).to_query %>"
      data-infinite-scroll-page-value="<%= params[:page]&.to_i || 1 %>">

      <div class="infinite-scroll-spinner" hidden><div class="spinner"></div></div>
    </div>
  <% else %>
    <%= render partial: "pages/end_of_results" %>
  <% end %>
<% end %>

<%= render(partial: 'shared/arrow_to_top') %>

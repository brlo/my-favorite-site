<div class="match">
  <h4>
    <% match_thumb_url = m.cover.present? ? m.cover.micro.url : m.parent_for_preview&.cover&.micro&.url %>
    <% if match_thumb_url %><img src="<%= match_thumb_url %>" loading="lazy" class="thumb"/><% end %>

    <a href="<%= my_page_link_to("/#{m.path}") %>">
      <%= m.title %>
    </a>

    <div class='parent-link'><%= m.parent_for_preview&.title %></div>
  </h4>

  <% m.highlighted_snippets&.each do |snippet| %>
    <div class='line' data-controller="text-fragment">
      <a href="<%= my_page_link_to("/#{m.path}") %>"
       data-text-fragment-target="link"
       data-text-fragment-base-url-value="<%= my_page_link_to("/#{m.path}") %>"
       data-turbo='false'>
        <span data-text-fragment-target="snippet" class="snippet-text">
          <%= verse_alone_clean(sanitize(snippet, tags: %w(strong)).html_safe) %>
        </span>…
      </a>
    </div>
  <% end %>
</div>

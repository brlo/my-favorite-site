<%# h1 страницы: рендерится либо под обложкой, либо (при заданном cover_overlay_bg) поверх неё %>
<h1
  class="title"
  id="current-address"
  data-book-short-name="<%= @page.path %>"
  data-lang-ui="<%= I18n.locale %>"
  data-lang-content="<%= @content_lang %>"
  data-book-code=""
  data-page-path="<%= @page.path %>"
  data-disable-chapters="<%= @is_disable_chapters ? 1 : 0 %>"
  data-chapter="<%= @chapter_current %>"
  itemprop="headline"
>
  <% if @page.is_page_bib_comment? %>
    <a href="<%= my_bib_link_to("/#{@page.link_to_bible_verse}") %>"><%= @page.title %></a>  |
    <%= t('bible_page.comment_title') %>
  <% else %>
    <%= @page.title %>
  <% end %>
</h1>

<% if @page.is_bibleox %>
  <div class="translation-notice">
    <span class="translation-icon">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6">
        <path stroke-linecap="round" stroke-linejoin="round" d="m21 7.5-2.25-1.313M21 7.5v2.25m0-2.25-2.25 1.313M3 7.5l-2.25-1.313M3 7.5l2.25 1.313M3 7.5v2.25m9 3 2.25-1.313M12 12.75l-2.25-1.313M12 12.75V15m0 6.75 2.25-1.313M12 21.75V19.5m0 2.25-2.25-1.313m0-16.875L12 2.25l2.25 1.313M21 14.25v2.25l-2.25 1.313m-13.5 0L3 16.5v-2.25" />
      </svg>
    </span>
    <div class="translation-tooltip">
      <span class="title"><%= ::I18n.t('tips.bibleox_translated') %></span>
      <p><%= ::I18n.t('tips.bibleox_translated_desc') %></p>
    </div>
  </div>
<% end %>

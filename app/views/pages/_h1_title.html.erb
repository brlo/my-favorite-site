<%# h1 страницы: рендерится либо под обложкой, либо (при заданном cover_overlay_bg) поверх неё %>
<h1
  class="title<%= ' is-short' if @page.is_cover_title_short? %>"
  id="current-address"
  dir="<%= content_direction %>"
  data-book-short-name="<%= @page.path %>"
  data-lang-ui="<%= I18n.locale %>"
  data-lang-content="<%= @content_lang %>"
  data-book-code=""
  data-page-path="<%= @page.path %>"
  data-disable-chapters="<%= @is_disable_chapters ? 1 : 0 %>"
  data-chapter="<%= @chapter_current %>"
  itemprop="headline"
>
  <% if @page.is_page_bib_comment? %>
    <a href="<%= my_bib_link_to("/#{@page.link_to_bible_verse}") %>"><%= @page.title %></a>  |
    <%= t('bible_page.comment_title') %>
  <% else %>
    <%= @page.title %>
  <% end %>
</h1>

<% if @page.is_bibleox %>
  <div class="translation-notice"
       data-controller="translation-notice"
       data-action="pointerenter->translation-notice#pointerEnter pointerleave->translation-notice#pointerLeave">
    <button type="button" class="translation-icon"
            aria-label="<%= ::I18n.t('tips.bibleox_translated') %>"
            aria-describedby="translation-tooltip"
            aria-controls="translation-tooltip"
            aria-expanded="false"
            data-translation-notice-target="icon"
            data-action="pointerdown->translation-notice#pointerDown click->translation-notice#toggle focusin->translation-notice#show focusout->translation-notice#hide keydown.esc->translation-notice#hide">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="m21 7.5-2.25-1.313M21 7.5v2.25m0-2.25-2.25 1.313M3 7.5l-2.25-1.313M3 7.5l2.25 1.313M3 7.5v2.25m9 3 2.25-1.313M12 12.75l-2.25-1.313M12 12.75V15m0 6.75 2.25-1.313M12 21.75V19.5m0 2.25-2.25-1.313m0-16.875L12 2.25l2.25 1.313M21 14.25v2.25l-2.25 1.313m-13.5 0L3 16.5v-2.25" />
      </svg>
    </button>
    <div class="translation-tooltip" id="translation-tooltip" role="tooltip" data-translation-notice-target="tooltip"
         data-action="click->translation-notice#hide">
      <span class="title"><%= ::I18n.t('tips.bibleox_translated') %></span>
      <% ::I18n.t('tips.bibleox_translated_desc').split(/\n{2,}/).each do |paragraph| %>
        <p><%= paragraph.squish %></p>
      <% end %>
    </div>
  </div>
<% end %>

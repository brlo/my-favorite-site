<% if items.present? %>
  <div class='items'>

    <% items.each do |item| %>

      <% _class = [] %>
      <% is_link_target = false %>
      <% if item[:childs].present? %>
        <% _class.push('menu-subject') %>
      <% else %>
        <% _class.push('menu-unit', 'menu-link') %>
        <% is_link_target = true%>
        <% if (item[:is_gold] && item[:priority] == 1 && item[:title] =~ /Иисус Христос/); _class.push('God') end %>
        <% item[:is_empty] ? _class.push('not-exist') : nil %>
        <% item[:path].blank? ? _class.push('not-exist') : nil %>
      <% end %>

      <% item[:is_gold] ? _class.push('gold') : nil %>
      <%# Серые пункты выглядят для всех одинаково, но ссылкой работают только у админа %>
      <% is_clickable = !_class.include?('not-exist') || current_user&.is_admin? %>

      <% if is_link_target %>
      <div class='depth-<%= depth %> <%= _class.join(' ') %>' data-menu-filter-target="link">
      <% else %>
      <div class='depth-<%= depth %> <%= _class.join(' ') %>'>
      <% end %>
        <% if item[:childs].present? && item[:path].blank? %>
          <%= item[:title] %>
        <% elsif item[:path].presence %>
          <a<% if is_clickable %> href="<%= my_page_link_to("/#{item[:path]}", page_lang: page_lang) %>"<% end %>>
            <% if @menus_info %>
              <% icon_url = @menus_info.dig(item[:path], :icon) %>
              <% visits = @menus_info.dig(item[:path], :visits) %>
            <% end %>

            <% if icon_url %>
              <div class='icon'>
                <div class='real'><img src='<%= icon_url %>' loading="lazy"/></div>
              </div>
            <% end %>
            <span>
              <%= item[:title] %>
              <% if visits %>
                <div class='vis'>
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z" />
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                  </svg>
                  <%= visits %>
                </div>
              <% end %>
            </span>
          </a>
        <% else %>
          <% link_params = {menu_id: item[:id], parent_id: item[:page_id]} %>
          <% if is_clickable %>
            <a
              rel='noindex nofollow'
              href="<%= my_page_link_to("/#{ item[:title].to_s.gsub(/[^\p{L}0-9_\-\s\(\)\,]/, '') }", page_lang: page_lang) %>?<%= link_params.map{ |k,v| "#{k}=#{v}" }.join('&') %>">
              <span><%= item[:title] %></span>
            </a>
          <% else %>
            <a><span><%= item[:title] %></span></a>
          <% end %>
        <% end %>
      </div>

      <% if item[:childs].present? %>
        <div class='level'>
          <%= render(partial: 'pages/menu', locals: {items: item[:childs], depth: depth+1, page_lang: page_lang}) %>
        </div>
      <% end %>

    <% end %>
  </div>
<% end %>

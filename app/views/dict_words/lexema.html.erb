<h1><%= t('bib_word_info.lexema_title', lexema: @lexema) %></h1>

<p class="lexema-summary">
  <%= t('bib_word_info.lexema_verses_count', count: @addrs.total_count) %>.
  <%= t('bib_word_info.lexema_forms') %>: <%= @forms.join(', ') %>
</p>

<div class="lexema-verses">
  <% @addrs.each do |addr| %>
    <% greek, translated = @greek[addr], @translated[addr] %>
    <% greek_re, translated_re = verse_pair_highlights(greek, translated, greek_fallback: @forms) { |wi| @lexemas_nfc.include?(wi['lex'].to_s.unicode_normalize(:nfc)) } %>
    <%= render 'verse_pair', addr:, greek:, translated:, greek_re:, translated_re: %>
  <% end %>
</div>

<%= paginate @addrs %>

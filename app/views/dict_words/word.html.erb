<h1><%= t('bib_word_info.h1_title', word: @dict_words&.first&.word || @bib_word&.word) %></h1>

<% if @dict_words&.any? %>
  <div class="dict-words">
    <% @dict_words.each do |w| %>
      <div class="dict-word">
        <div class='dict-name'>
          <%= ::DictWord::DICTS.dig(w.dict, 'name') %>
          <% if current_user&.is_admin? %>
            [<a href="<%= "#{::SETTINGS['admin']['url'] }/dict_words/#{ w.id }/" %>">e</a>]
          <% end %>
        </div>
        <h2>
          <%= w.word %> —
          <%= w.translation_short %>
        </h2>
        <div class='transcription'>
          <% if w.transcription.present? %>
            [<%= w.transcription %>]
          <% end %>
        </div>
        <% if w.tag.present? %>
          <div class='tag'>Признак: <%= w.tag %></div>
        <% end %>
        <div class='translation'>
            <% if w.translation_short.present? %>
              <div class='single'>
                <%= w.translation_short %>
              </div>
            <% end %>
            <% if w.translation.present? %>
              <div class='multiple'><%= w.translation %></div>
            <% end %>
            <% if w.desc.present? %>
              <div class='desc'><%= sanitize(w.desc.to_s, tags: ::Page::ALLOW_TAGS, attributes: ::Page::ALLOW_ATTRS).html_safe %></div>
            <% end %>
        </div>
      </div>
    <% end %>
  </div>

  <div class="lexemas">
      <% @lexemas.each do |l| %>
          <div class="lexema">
              <div class='word'>
                <%= l.word %>
                <% if l.transcription.present? %>
                  [<%= l.transcription %>]
                <% end %>
              </div>
              <% if l.present? %>
                <div><%= t('bib_word_info.lexema') %>: <%= l.lexema %></div>
              <% end %>
              <div><%= t('bib_word_info.repeat_count') %>: <%= l.counts %></div>
          </div>
      <% end %>
  </div>
<% end %>

<% if @bib_word.present? %>
  <div class="construction-banner">
    ⚠️ <%= t('bib_word_info.warning') %>
  </div>

  <!-- Заголовок -->
  <h2>
    <%= @bib_word.word %>
    <span class="transcription">[<%= @bib_word.transcriptions.to_h.dig('en').to_a.join(', ') %>]</span>
  </h2>

  <!-- Основная информация -->
  <div class="word-section">
    <div class="info-block">
      <h3><%= t('bib_word_info.translations') %></h3>
      <% @bib_word.translations.to_h.each do |lang, words| %>
        <% next if I18n.locale == :ja && lang == 'ru' %>
        <% next if I18n.locale == :ru && lang == 'jp' %>
        <div class="translation-item">
          <strong><%= lang %>:</strong> <%= words.to_a.join(', ') %>
        </div>
      <% end %>
    </div>

    <div class="info-block">
      <h3><%= t('bib_word_info.morphology') %></h3>
      <% @bib_word.info.to_h.each do |key, value| %>
        <% next if value.blank? %>
        <div class="morph-item">
          <strong><%= I18n.t("bib_word_info.morph")[key.to_s.downcase.to_sym].presence || key %>:</strong>
          <%= I18n.t("bib_word_info.morph")[value.to_s.downcase.to_sym].presence || value %>
        </div>
      <% end %>
    </div>

    <div class="info-block stats">
      <h3><%= t('bib_word_info.statistic') %></h3>
      <div>ID: <strong><%= @bib_word.id %></strong></div>
      <div><%= t('bib_word_info.repeat_count') %>: <strong><%= @bib_word.counts %></strong></div>
      <div><%= t('bib_word_info.repeat_count_by_lexema') %>: <strong><%= @bib_word.counts_by_lexema %></strong></div>
      <div><%= t('bib_word_info.lexema') %>: <strong><%= @bib_word.lexema %></strong></div>
    </div>
  </div>

  <!-- Ссылки на все стихи -->
  <div class="info-block">
    <h3><%= t('bib_word_info.all_verses_title') %> (<%= @bib_word.addrs.size %>)</h3>
    <div class="verses-list">
      <% @bib_word.addrs.each_with_index do |addr, i| %>
        <a href="<%= my_bib_link_to(::AddressConverter.addr_to_link(addr)) %>">
          <%= ::AddressConverter.humanize(addr) %>
        </a><%= i+1 < @bib_word.addrs.length ? ', ' : '' %>
      <% end %>
    </div>
  </div>

  <!-- Примеры стихов -->
  <div class="examples">
    <div class="info-block">
      <h3><%= t('bib_word_info.random_verses_title') %></h3>
      <% ::Verse.where(address: @bib_word.addrs.sample(5), tr_code: 'gr-ru').each do |v| %>
        <div class="verse-example">
          "<%= verse_alone_clean(highlight(v.text, @bib_word.word).html_safe) %>"
          (<a href="/<%= I18n.locale %>/gr-ru/<%= v.book %>/<%= v.chapter %>#L<%= v.line %>"><%= I18n.t("books.short.#{ v.book }") %>. <%= v.chapter %>:<%= v.line %></a>)
        </div>
      <% end %>
    </div>

    <div class="info-block">
      <h3><%= t('bib_word_info.random_verses_translated_title') %></h3>
      <% ::Verse.where(address: @bib_word.addrs.sample(5), tr_code: current_bib_lang()).each do |v| %>
        <div class="verse-example">
          "<%= verse_alone_clean(highlight(v.text.to_s, @bib_word.translations.to_h[I18n.locale.to_s]).html_safe) %>"
          (<a href="<%= my_bib_link_to("/#{ v.book }/#{ v.chapter }#L#{ v.line }") %>"><%= I18n.t("books.short.#{ v.book }") %>. <%= v.chapter %>:<%= v.line %></a>)
        </div>
      <% end %>
    </div>
  </div>
<% end %>

<% if @dict_words.nil? && @bib_word.nil? %>
  <div class='error-not-found'>
    <div class='error-msg'>Ошибка 404 — Такое слово не найдено.</div>
    <div class='propose'>
      Хотите
      <a href="<%= "#{::SETTINGS['admin']['url'] }/dict_words/new?word=#{@word_clean}" %>">создать?</a>
    </div>
  </div>
<% end %>

<style>
  .construction-banner {
    background: #fff3cd;
    border: 1px solid #ffc107;
    padding: 8px 16px;
    border-radius: 6px;
    font-weight: bold;
    color: #856404;
    margin-bottom: 20px;
  }

  h2 {
    margin: 10px 0 20px 0;
    padding-bottom: 10px;
    border-bottom: 1px solid var(--border-main);
    font-size: 2em;
  }

  .transcription {
    color: var(--text-secondary);
    font-size: 0.6em;
    font-weight: normal;
    margin-left: 10px;
  }

  .word-section {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 20px;
    margin-bottom: 30px;
  }

  .info-block {
    background: var(--bg-card);
    padding: 12px 16px;
    border-radius: 6px;
    border: 1px solid var(--border-main);
  }

  .info-block h3 {
    margin: 0 0 8px 0;
    font-size: 1em;
    color: var(--text-secondary);
    border-bottom: 1px solid var(--border-main);
    padding-bottom: 5px;
  }

  .translation-item,
  .morph-item {
    display: block;
    margin: 3px 0;
  }

  .stats div {
    margin: 3px 0;
  }

  .verses-list {
    max-height: 120px;
    overflow-y: auto;
    line-height: 1.6;
    font-size: 0.9em;
  }

  .examples {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    margin-top: 10px;
  }

  .verse-example {
    margin: 10px 0;
    padding: 4px 0;
  }

  @media (max-width: 768px) {
    .word-section {
      grid-template-columns: 1fr;
    }

    .examples {
      grid-template-columns: 1fr;
    }
  }
</style>


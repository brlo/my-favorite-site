<div class='bar-description'><%= ::I18n.t('lang_select_tip') %></div>
<div id='text-bar'>
  <div class='bar-el'>

    <div data-controller="bbx-select"
          data-bbx-select-action-value="navigate"
          data-bbx-select-path-position-replace-value='1'>
      <select data-bbx-select-target="select" name="locale" id='lang-select' class="search-select">

        <%
          bib_langs = {
            t('dropdown.translates') => {
              'eng-nkjv' => {short: 'NKJV'},
              'en-nrsv'  => {short: 'NRSV'},
              'ru'       => {short: 'RST'},
              'csl-pnm'  => {short: 'ELZ'},
              'csl-ru'   => {short: 'ELZ-RU'},
              'arab-avd' => {short: 'AVD'},
              'jp-ni'    => {short: 'N.Interc'},
              'cn-ccbs'  => {short: 'CCBS'},
              'ge-sch'   => {short: 'SCH'},
            },
            t('dropdown.interliners') => {
              'gr-en' => {short: 'BX'},
              'gr-ru' => {short: 'BX'},
              'gr-jp' => {short: 'BX'},
            },
            t('dropdown.encient_texts') => {
              'gr-lxx-byz' => {short: 'LXX+Byz', is_translate: true},
              'heb-osm' => {short: 'OSM+DHNT', is_translate: true},
            }
          }
        %>

        <% bib_langs.each do |select_group_name, langs| %>
          <optgroup label="<%= select_group_name %>">
          <% langs.sort_by { |lang, _| I18n.locale.to_s == BIB_LANG_TO_LOCALE[lang] ? 0 : 1 }.each do |lang_name, attrs| %>
            <option
              value='<%= lang_name %>'
              <%= 'selected' if @current_bib_lang == lang_name %>>
                <%= bib_lang_string_full(lang_name, short: attrs[:short], is_translate: attrs[:is_translate]) %>
            </option>
          <% end %>
          </optgroup>
        <% end %>

      </select>
      <div data-bbx-select-target="custom"></div>
    </div>

  </div>


  <div class='right-group'>
    <% if @audio_file %>
      <div class='bar-el btn' id='btn-play-text'
        data-controller='audio-player'
        data-audio-player-audio-link-value='<%= my_res_link_to(@audio_file) %>'
        data-action="click->audio-player#toggleVision">

        <svg style="width: 15px; margin-right: 5px;" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-6 h-6">
          <path d="M13.5 4.06c0-1.336-1.616-2.005-2.56-1.06l-4.5 4.5H4.508c-1.141 0-2.318.664-2.66 1.905A9.76 9.76 0 001.5 12c0 .898.121 1.768.35 2.595.341 1.24 1.518 1.905 2.659 1.905h1.93l4.5 4.5c.945.945 2.561.276 2.561-1.06V4.06zM18.584 5.106a.75.75 0 011.06 0c3.808 3.807 3.808 9.98 0 13.788a.75.75 0 11-1.06-1.06 8.25 8.25 0 000-11.668.75.75 0 010-1.06z" />
          <path d="M15.932 7.757a.75.75 0 011.061 0 6 6 0 010 8.486.75.75 0 01-1.06-1.061 4.5 4.5 0 000-6.364.75.75 0 010-1.06z" />
        </svg>

        <%= I18n.t('voice') %>
      </div>
    <% end %>
  </div>
</div>

<% content_for(:head) do %>
    <meta property="og:image" content="<%= my_res_link_to("/favicons/bibleox-for-social-#{ ::I18n.locale == :ru ? 'ru' : 'en' }.png") %>"/>
    <meta property="og:image:width" content="1200"/>
    <meta property="og:image:height" content="630"/>
    <meta property="og:type" content="book"/>
    <% @meta_book_tags&.each do |tag| %>
    <meta property="og:book:tag" content="<%= tag %>"/>
    <% end %>
    <% if @meta_book_tags %>
    <meta name="keywords" content="<%= @meta_book_tags.join(', ') %>" />
    <% end %>
    <meta property="og:url" content= "<%= @canonical_url %>" />
    <meta property="og:locale" content= "<%= ::I18n.locale %>" />
    <meta property="og:locale:alternate" content= "<%= ::I18n.locale == :ru ? 'en' : 'ru' %>" />
<% end %>

<div class='hint' style='margin-top: 0;'><%= t('search_page.title') %>: </div>
<form class='uniq-search-form' data-controller='form-help'>
  <div id='search-input-area'>
    <input class='pretty search-tree-input' name="t" type="text" minlength="3" required autocomplete='off' autofocus placeholder='<%= I18n.t("search_page.search_placeholder") %>' value='<%= @search_text %>'>
    <button type="submit" class='search-icon'>
      <svg width="20" height="20" viewBox="0 0 20 20"><path d="M14.386 14.386l4.0877 4.0877-4.0877-4.0877c-2.9418 2.9419-7.7115 2.9419-10.6533 0-2.9419-2.9418-2.9419-7.7115 0-10.6533 2.9418-2.9419 7.7115-2.9419 10.6533 0 2.9419 2.9418 2.9419 7.7115 0 10.6533z" stroke="currentColor" fill="none" fill-rule="evenodd" stroke-linecap="round" stroke-linejoin="round"></path></svg>
    </button>
  </div>

  <br>

  <div class='search-options choices-container'>

    <!-- Книги -->
    <span class='search-param'
      data-controller='choices-select'
      data-choices-select-placeholder-value="<%= I18n.t('search_page.any_book') %>"
      data-choices-select-search-enabled-value="true"
      data-choices-select-position-value="down">

      <select id='search-books' name='book' class='search-select' data-action='change->form-help#safeSubmitForm'>
        <option value='' <% if @search_books.blank? %>selected<% end %>><%= I18n.t('search_page.any_book') %></option>
        <option value='z1' <% if @search_books == 'z1' %>selected<% end %>><%= I18n.t('search_page.old_testament') %></option>
        <option value='z2' <% if @search_books == 'z2' %>selected<% end %>><%= I18n.t('search_page.new_testament') %></option>
        <option value='e4' <% if @search_books == 'e4' %>selected<% end %>><%= I18n.t('search_page.gospel') %></option>
        <% BOOKS.each do |book, params| %>
          <option value='<%= book %>' <% if @search_books == book %>selected<% end %> ><%= I18n.t("books.mid.#{book}") %></option>
        <% end %>
      </select>
    </span>

    <!-- Точность -->
    <span class='search-param'
      data-controller='choices-select'
      data-choices-select-search-enabled-value="false"
      data-choices-select-position-value="down">

      <select id="search-accuracy" name="acc" class='search-select' data-action='change->form-help#safeSubmitForm'>
        <option value='similar' <% if @search_accuracy == 'similar' %>selected<% end %>><%= I18n.t('search_page.similar_phrase') %></option>
        <option value='exact' <% if @search_accuracy == 'exact' %>selected<% end %>><%= I18n.t('search_page.exact_phrase') %></option>
      </select>
    </span>

    <!-- Язык -->
    <span class='search-param'
      data-controller='choices-select'
      data-choices-select-placeholder-value="<%= bib_lang_string_full('ru', short: 'RST') %>"
      data-choices-select-search-enabled-value="true"
      data-choices-select-position-value="down">

      <select id="search-lang" name="l" class='search-select' data-action='change->form-help#safeSubmitForm'>
        <option value='ru' <% if @search_lang == 'ru' %>selected<% end %>><%= bib_lang_string_full('ru', short: 'RST') %></option>
        <!-- остальные опции -->
      </select>
    </span>

    <button type='submit' style='display: none;'>Submit</button>
  </div>

</form>

<div class='hint'><%= t('search_page.matches') %>: <%= @matches_count %></div>
<hr>

<article>
  <%#= javascript_include_tag "first_needs", media: "all" %>
<% if @matches_count > 0 %>

  <% @verses.each do |v| %>
    <div class='line'>
      <% line_text = sanitize(v.snippet, tags: %w(strong)) %>
      «<%= verse_alone_clean(line_text.html_safe) %>»
      (<a href="<%= my_bib_link_to("/#{ v.book }/#{ v.chapter }#L#{ v.line }") %>"><%= ::I18n.t("books.short.#{ v.book }") %>. <%= v.chapter %>:<%= v.line %></a>)
    </div>
    <br>
  <% end %>

<% else %>
  <div class='tip'><%= I18n.t('tips.search_was_return_zero_results') %></div>
<% end %>
</article>

<%#= javascript_include_tag "search", media: "all" %>

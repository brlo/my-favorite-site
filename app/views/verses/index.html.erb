<% content_for(:head) do %>
  <meta property="og:image" content="<%= my_res_link_to("/favicons/bibleox-for-social-#{ ::I18n.locale == :ru ? 'ru' : 'en' }.png") %>"/>
  <meta property="og:image:width" content="1200"/>
  <meta property="og:image:height" content="630"/>
  <meta property="og:type" content="article"/>
  <% @meta_book_tags.each do |tag| %>
  <meta property="og:book:tag" content="<%= tag %>"/>
  <% end %>
  <meta name="keywords" content="<%= @meta_book_tags.join(', ') %>" />
  <meta property="og:url" content= "<%= @canonical_url %>" />
  <meta property="og:locale" content= "<%= ::I18n.locale %>" />

  <% current_seo_lang = ::LANG_FOR_BIB_LANG[@current_bib_lang] %>
  <%# self-reference: Google ждёт, что каждая версия перечисляет и саму себя %>
  <% if current_seo_lang.present? && ::PRIMARY_BIB_LANG_BY_LANG[current_seo_lang] == @current_bib_lang %>
    <link rel="alternate" hreflang="<%= current_seo_lang %>" href="<%= @canonical_url %>" />
  <% end %>

  <% ::PRIMARY_BIB_LANG_BY_LANG.each do |lang_seo, bib_lang| %>
    <% next if bib_lang.to_s == @current_bib_lang.to_s %>
    <% ui_locale = BIB_LANG_TO_LOCALE[bib_lang] %>
    <% next if ui_locale.blank? %>
    <meta property="og:locale:alternate" content= "<%= lang_seo %>" />
    <link rel="alternate" hreflang="<%= lang_seo %>" href="https://bibleox.com/<%= ui_locale %>/<%= bib_lang %>/<%= [@book_code, @chapter].join('/') %>/" />
  <% end %>
  <%# версия по умолчанию для читателей с непокрытым языком - русский Синодальный %>
  <link rel="alternate" hreflang="x-default" href="https://bibleox.com/ru/ru/<%= [@book_code, @chapter].join('/') %>/" />
<% end %>

<section id='chapter-content' itemscope itemtype="http://schema.org/Article">
  <%= render(partial: 'verses/chapters') %>
  <%= render(partial: 'verses/text_bar') %>
  <div id='bib-text-area' lang="<%= ::BIB_LANG_TO_LOCALE[@content_lang] || ::BIB_LANG_TO_LOCALE[@current_bib_lang] %>">
    <%= render(partial: 'verses/text') %>
  </div>
</section>

<% content_for(:end_of_page) do %>
  <%= render(partial: 'verses/select_bar') %>
  <%#= javascript_include_tag "index", media: "all" %>
<% end %>

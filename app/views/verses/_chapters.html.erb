<div id='chapter-header'>

  <h1
      class="title"
      id='current-address'
      data-book-short-name='<%= bib_book_name(@book_code, :short) %>'
      data-lang-ui='<%= I18n.locale %>'
      data-lang-content='<%= @content_lang %>'
      data-book-code='<%= @book_code %>'
      data-chapter='<%= @chapter %>'
      style='text-align: center;'
      itemprop="headline"
    >
    <a href="<%= my_bib_link_to("/#{@book_code}/1/") %>" id='current-book' data-action='books-menu#show'><%= bib_book_name(@book_code, :full) %></a>
  </h1>

  <% if @content_lang == 'jp-box' %>
    <%= render(partial: 'verses/translation_badge') %>
  <% end %>

<% if @verses.none? %>
  <div class='error'><%= ::I18n.t("errors.no_translation_for_this_book") %></div>
  <% if @other_translations.present? %>
    <div class='other-translations'>
      <div class='small hint'><%= ::I18n.t('errors.other_translations_for_book') %></div>
      <% @other_translations.each do |tr_code| %>
        <a href="<%= bible_chapter_link(@book_code, tr_code, @chapter) %>"><%= bib_lang_string_full(tr_code, short: ::BIB_LANG_SHORT[tr_code]) %></a>
      <% end %>
    </div>
  <% end %>
</div>
<% else %>
  <div class='small hint'><%= @is_psalm ? ::I18n.t('psalms') : ::I18n.t('chapters') %></div>
  <nav id='menu-chapters'>
    <% prev_chapter = @chapter - 1 %>
    <% now_chapter = @chapter %>
    <% next_chapter = @chapter + 1 %>
    <% (1..::BOOKS[@book_code][:chapters]).each do |i| %>
      <% classes = "chapter-num" %>
      <% i == now_chapter ? classes = ' selected' : nil %>
      <a id="ch-<%= i %>" data-chapter="<%= i %>" class="<%= classes %>" href="<%= my_bib_link_to("/#{@book_code}/#{i}/") %>"><%= i %></a>
    <% end %>
  </nav>
</div>
<% end %>
